@@ -0,0 +1,18 @@
+#pragma once
+#include <Windows.h>
+
+namespace dcs_joint_nr {
+inline bool enabled() noexcept {
+    static const bool experiment=GetEnvironmentVariableW(L"DCS_NR_JOINT",nullptr,0)!=0;
+    return experiment;
+}
+inline bool option(const char* symbol,int setting) noexcept {
+    if(!enabled())return false;
+    using Control=int(__cdecl*)(int);
+    const auto module=GetModuleHandleW(L"CheekyFoveatedDLSSRuntime.dll");
+    const auto fn=module?reinterpret_cast<Control>(GetProcAddress(module,symbol)):nullptr;
+    return fn&&fn(setting)!=0;
+}
+inline bool control(int setting=-1) noexcept { return option("DcsJointNr_ControlV1",setting); }
+inline bool focus_stability(int setting=-1) noexcept { return option("DcsJointNr_FocusStabilityV1",setting); }
+}
diff --git a/src/dcs_joint_nr_sources.hpp b/src/dcs_joint_nr_sources.hpp
new file mode 100644
index 0000000..3e7b519
--- /dev/null
+++ b/src/dcs_joint_nr_sources.hpp
@@ -0,0 +1,116 @@
+#pragma once
+#include "dcs_joint_nr_control.hpp"
+#include "ngx_abi.hpp"
+#include "quad_view_bridge.hpp"
+#include "settings.hpp"
+#include <array>
+#include <mutex>
+#include <utility>
+#include <wrl/client.h>
+
+namespace cheeky::foveated_dlss::joint_nr {
+using Microsoft::WRL::ComPtr;
+struct Rect { unsigned x{},y{},width{},height{}; };
+struct Peripheral {
+    std::array<ComPtr<ID3D11Texture2D>,2> guides;
+    std::array<Rect,2> guideRects;
+    ComPtr<ID3D11Texture2D> postColor;
+    Rect postRect;
+    float motionX{1},motionY{1};
+    uint64_t nativeFrame{};
+};
+inline std::atomic<bool> active{dcs_joint_nr::enabled()};
+inline std::atomic<bool> focusStability{[] {
+    wchar_t value[2]{};
+    return GetEnvironmentVariableW(L"DCS_NR_FOCUS_STABILITY",value,2)!=1||value[0]!=L'0';
+}()};
+inline thread_local bool frameStability{};
+inline std::mutex sourceMutex;
+inline std::array<Peripheral,2> sources;
+inline thread_local std::array<uint64_t,2> inputFrames{};
+inline thread_local std::array<uint64_t,2> focusFrames{};
+
+inline bool control(int value) {
+    if(!dcs_joint_nr::enabled())return false;
+    if(value>=0)active.store(value!=0,std::memory_order_release);
+    return active.load(std::memory_order_acquire);
+}
+inline void observe(ID3D11DeviceContext* context,const NgxHandle* handle,const NgxParameters* p) {
+    if(!context||!p)return;
+    const auto id=reinterpret_cast<uint64_t>(handle);
+    const auto quad=quad_layer_view_snapshot();
+    const auto* role=quad_view_assignment(quad,id,stereo_view_generation(id));
+    if(!role||role->focus||role->eye_index>=2)return;
+    const auto nativeFrame=inputFrames[role->eye_index];
+    if(!nativeFrame)return;
+    Peripheral next;
+    constexpr const char* keys[]{"Depth","MotionVectors"};
+    for(unsigned i=0;i<next.guides.size();++i){
+        ID3D11Resource* source{};
+        if(!ngx_succeeded(p->Get(keys[i],&source))||!source||
+           FAILED(source->QueryInterface(IID_PPV_ARGS(&next.guides[i]))))return;
+    }
+    const auto read=[&](const char* name){unsigned value=0;p->Get(name,&value);return value;};
+    unsigned renderWidth=read("DLSS.Render.Subrect.Dimensions.Width");
+    unsigned renderHeight=read("DLSS.Render.Subrect.Dimensions.Height");
+    if(!renderWidth)renderWidth=read("Width");
+    if(!renderHeight)renderHeight=read("Height");
+    const unsigned outWidth=read("OutWidth"),outHeight=read("OutHeight");
+    const bool lowMotion=(get_ngx_integer_bits(p,"DLSS.Feature.Create.Flags")&2u)!=0;
+    next.guideRects={{
+        {read("DLSS.Input.Depth.Subrect.Base.X"),read("DLSS.Input.Depth.Subrect.Base.Y"),renderWidth,renderHeight},
+        {read("DLSS.Input.MV.Subrect.Base.X"),read("DLSS.Input.MV.Subrect.Base.Y"),
+         lowMotion?renderWidth:outWidth,lowMotion?renderHeight:outHeight}
+    }};
+    p->Get("MV.Scale.X",&next.motionX);
+    p->Get("MV.Scale.Y",&next.motionY);
+    std::lock_guard lock(sourceMutex);
+    auto& cached=sources[role->eye_index];
+    cached.nativeFrame=0;
+    cached.postColor.Reset();
+    ComPtr<ID3D11Device> device;context->GetDevice(&device);
+    for(unsigned i=0;i<next.guides.size();++i) {
+        D3D11_TEXTURE2D_DESC source{};next.guides[i]->GetDesc(&source);
+        auto& rect=next.guideRects[i];
+        if(!rect.width||!rect.height||uint64_t(rect.x)+rect.width>source.Width||
+           uint64_t(rect.y)+rect.height>source.Height||source.SampleDesc.Count!=1||source.ArraySize!=1)return;
+        const bool full=(source.BindFlags&D3D11_BIND_DEPTH_STENCIL)!=0;
+        D3D11_TEXTURE2D_DESC desc=source,old{};
+        if(!full){desc.Width=rect.width;desc.Height=rect.height;}
+        desc.MipLevels=1;desc.Usage=D3D11_USAGE_DEFAULT;desc.BindFlags=D3D11_BIND_SHADER_RESOURCE;
+        desc.MiscFlags=desc.CPUAccessFlags=0;
+        auto& snapshot=cached.guides[i];
+        if(snapshot)snapshot->GetDesc(&old);
+        if(old.Width!=desc.Width||old.Height!=desc.Height||old.Format!=desc.Format) {
+            snapshot.Reset();
+            if(FAILED(device->CreateTexture2D(&desc,nullptr,&snapshot)))return;
+        }
+        const D3D11_BOX box{rect.x,rect.y,0,rect.x+rect.width,rect.y+rect.height,1};
+        context->CopySubresourceRegion(snapshot.Get(),0,0,0,0,next.guides[i].Get(),0,full?nullptr:&box);
+        if(!full)rect.x=rect.y=0;
+    }
+    cached.guideRects=next.guideRects;cached.motionX=next.motionX;cached.motionY=next.motionY;
+    cached.nativeFrame=nativeFrame;
+}
+inline void observe_output(const CheekyQuadSourceD3D11V1& source) {
+    if(!inputFrames[0]&&!inputFrames[1])return;
+    const auto quad=quad_layer_view_snapshot();
+    const auto* role=quad_view_assignment(quad,source.dlss_view,source.registration_generation);
+    if(!role||role->focus||role->eye_index>=2)return;
+    std::lock_guard lock(sourceMutex);
+    auto& entry=sources[role->eye_index];
+    if(!entry.nativeFrame||entry.nativeFrame!=inputFrames[role->eye_index])return;
+    // The native SR output is consumed before the peripheral post passes run.
+    entry.postColor=static_cast<ID3D11Texture2D*>(source.texture);
+    entry.postRect={source.x,source.y,source.width,source.height};
+}
+inline Peripheral take(unsigned eye,uint64_t nativeFrame) {
+    std::lock_guard lock(sourceMutex);
+    auto& source=sources[eye];
+    if(source.nativeFrame!=nativeFrame)return {};
+    auto result=source;
+    source.postColor.Reset();
+    source.nativeFrame=0;
+    return result;
+}
+}
diff --git a/src/dcs_joint_nr_runtime.inc b/src/dcs_joint_nr_runtime.inc
new file mode 100644
index 0000000..1f87220
--- /dev/null
+++ b/src/dcs_joint_nr_runtime.inc
@@ -0,0 +1,36 @@
+extern "C" __declspec(dllexport) BOOL __cdecl DcsJointNr_ControlV1(int setting) {
+    return joint_nr::control(setting)?TRUE:FALSE;
+}
+
+extern "C" __declspec(dllexport) BOOL __cdecl DcsJointNr_RequestedV1() {
+    bool wanted=false;
+    if(joint_nr::active.load(std::memory_order_acquire)){
+        const auto settings=current_settings();
+        wanted=settings.nr_enabled&&settings.nr_processing_order==NrProcessingOrder::before_upscaling&&
+            !settings.quad_nr_selection.bypass;
+    }
+    // DcsQvCull calls once per stereo frame. Retire captures here, after both eyes have finished.
+    static thread_local bool previousWanted=false;
+    if(previousWanted&&!wanted){
+        std::lock_guard lock(joint_nr::sourceMutex);
+        joint_nr::sources={};
+    }
+    previousWanted=wanted;
+    if(!wanted)return FALSE;
+    joint_nr::frameStability=joint_nr::focusStability.load(std::memory_order_relaxed);
+    return TRUE;
+}
+
+extern "C" __declspec(dllexport) void __cdecl DcsJointNr_SetFocusFrameV1(unsigned eye,uint64_t nativeFrame) {
+    joint_nr::focusFrames[eye]=nativeFrame;
+}
+
+extern "C" __declspec(dllexport) void __cdecl DcsJointNr_SetInputFrameV1(unsigned eye,uint64_t nativeFrame) {
+    joint_nr::inputFrames[eye]=nativeFrame;
+}
+
+extern "C" __declspec(dllexport) BOOL __cdecl DcsJointNr_FocusStabilityV1(int setting) {
+    if(setting>=0)joint_nr::focusStability.store(setting!=0,std::memory_order_relaxed);
+    return joint_nr::focusStability.load(std::memory_order_relaxed)?TRUE:FALSE;
+}
+
