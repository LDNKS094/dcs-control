+#pragma once
+#include "quad_blend_shader.hpp"
+#include <array>
+namespace cheeky::foveated_dlss::joint_nr {
+struct Warp {
+    std::array<float,4> focus;
+    std::array<float,4> motionScale;
+    std::array<unsigned,2> packedSize,focusSize;
+    unsigned limitEnabled{},limitSeed{};
+    std::array<unsigned,2> padding{};
+    std::array<float,4> blend,previousFocus;
+    std::array<std::array<float,4>,6> sourceRects;
+};
+static_assert(sizeof(Warp)==48*sizeof(float));
+
+inline constexpr char shader[]=CHEEKY_QUAD_BLEND_HLSL R"HLSL(
+cbuffer Params:register(b0){
+    float4 Focus;
+    float4 MotionScale;
+    uint2 PackedSize,FocusSize;
+    uint LimitEnabled,LimitSeed;
+    uint2 Padding;
+    float4 Blend,PreviousFocus;
+    float4 SourceRects[6];
+};
+SamplerState LinearClamp:register(s0);
+Texture2D<float4> Outer:register(t0);
+Texture2D<float4> Inner:register(t1);
+#ifdef JOINT_NR_LIMIT
+Texture2D<float4> History:register(t2);
+Texture2D<float2> Motion:register(t3);
+Texture2D<float4> Tone:register(t4);
+StructuredBuffer<float4> LimitBounds:register(t5);
+RWTexture2D<float4> NextHistory:register(u0);
+RWStructuredBuffer<float4> MeasuredBounds:register(u1);
+float brightness(float3 rgb){return max(0.0,dot(rgb,float3(.2126,.7152,.0722)))+.015;}
+float correctionStops(float3 source,float3 output){return log2(brightness(output)/brightness(source));}
+groupshared uint BoundsHistogram[256];
+groupshared uint GuideSamples;
+float decodeBin(uint bin){
+    const float v=(float(bin)+.5)/128-1;
+    return .25*v/(1-abs(v));
+}
+[numthreads(256,1,1)]
+void GuideLimit(uint i:SV_GroupIndex){
+    BoundsHistogram[i]=0;
+    if(i==0)GuideSamples=0;
+    GroupMemoryBarrierWithGroupSync();
+    const uint2 samples=(max(FocusSize,33)-33)/12+1;
+    for(uint j=i;j<samples.x*samples.y;j+=256){
+        const float2 local=(16.5+12*float2(j%samples.x,j/samples.x))/FocusSize;
+        const float2 uv=lerp(Focus.xy,Focus.zw,local);
+        const float2 prior=uv+Motion.SampleLevel(LinearClamp,uv,0);
+        const float2 oldLocal=(prior-PreviousFocus.xy)/(PreviousFocus.zw-PreviousFocus.xy);
+        if(any(oldLocal<.03)||any(oldLocal>.97))continue;
+        const float raw=correctionStops(Outer.SampleLevel(LinearClamp,uv,0).rgb,Inner.SampleLevel(LinearClamp,uv,0).rgb);
+        const float delta=raw-History.SampleLevel(LinearClamp,prior,0).x;
+        // Compact the histogram tails while retaining precision around zero.
+        const uint bin=min(255u,(uint)((1+delta/(.25+abs(delta)))*128));
+        InterlockedAdd(BoundsHistogram[bin],1);
+        InterlockedAdd(GuideSamples,1);
+    }
+    GroupMemoryBarrierWithGroupSync();
+    if(i==0){
+        uint sum=0,lo=0,mid=0,hi=0;
+        if(GuideSamples){
+            const uint last=GuideSamples-1;
+            const uint lowRank=last/4,midRank=last/2,highRank=last*3/4;
+            for(uint bin=0;bin<256;++bin){
+                sum+=BoundsHistogram[bin];
+                if(sum<=lowRank)lo=bin+1;
+                if(sum<=midRank)mid=bin+1;
+                if(sum<=highRank)hi=bin+1;
+            }
+            MeasuredBounds[0]=float4(min(0.0,decodeBin(lo)),max(0.0,decodeBin(hi)),decodeBin(mid),0);
+        }else MeasuredBounds[0]=0;
+    }
+}
+[numthreads(8,8,1)]
+void ApplyLimit(uint3 i:SV_DispatchThreadID){
+    if(any(i.xy>=PackedSize))return;
+    const float3 a=Outer.Load(int3(i.xy,0)).rgb,b=Inner.Load(int3(i.xy,0)).rgb;
+    const float2 uv=(float2(i.xy)+.5)/PackedSize;
+    uint2 toneSize;
+    Tone.GetDimensions(toneSize.x,toneSize.y);
+    const float4 rect=SourceRects[0];
+    const float3 base=Tone.SampleLevel(LinearClamp,(rect.xy+uv*rect.zw)/toneSize,0).rgb;
+    const float raw=correctionStops(base,base+b-a);
+    float applied=raw;
+    if(!LimitSeed){
+        const float2 previousUv=uv+Motion.Load(int3(i.xy,0));
+        if(all(previousUv>=0.0)&&all(previousUv<1.0)){
+            const float previous=History.SampleLevel(LinearClamp,previousUv,0).y;
+            const float3 guide=LimitBounds[0].xyz;
+            const float change=clamp(raw-previous,guide.x,guide.y);
+            // Keep the Focus trend and let the remaining history error decay.
+            const float focusTrend=clamp(change,min(0.0,guide.z),max(0.0,guide.z));
+            applied=previous+focusTrend+.3*(raw-previous-focusTrend);
+        }
+    }
+    NextHistory[i.xy]=float4(correctionStops(a,b),applied,applied-raw,0);
+}
+#else
+#ifndef JOINT_NR_RESOLVE
+Texture2D<float> OuterDepth:register(t2);
+Texture2D<float> InnerDepth:register(t3);
+Texture2D<float2> OuterMotion:register(t4);
+Texture2D<float2> InnerMotion:register(t5);
+#endif
+RWTexture2D<float4> Output0:register(u0);
+RWTexture2D<float> PackedDepth:register(u1);
+RWTexture2D<float2> PackedMotion:register(u2);
+RWTexture2D<float4> Output1:register(u3);
+
+float2 focusUV(float2 uv){return (uv-Focus.xy)/(Focus.zw-Focus.xy);}
+uint2 pixel(float2 uv,uint index){
+    const float4 r=SourceRects[index];
+    return uint2(r.xy+clamp(uv*r.zw,0.0,r.zw-1));
+}
+float2 colorUV(float2 uv,uint index,float2 size){
+    const float4 r=SourceRects[index];
+    return (r.xy+clamp(uv*r.zw,.5,r.zw-.5))/size;
+}
+#ifndef JOINT_NR_RESOLVE
+float4 focusColor(float2 local,float2 size){
+    // Each tap represents a quarter of one peripheral-grid pixel in Focus UV.
+    const float2 step=.25/(float2(PackedSize)*(Focus.zw-Focus.xy));
+    return .25*(Inner.SampleLevel(LinearClamp,colorUV(local+step,1,size),0)+
+                Inner.SampleLevel(LinearClamp,colorUV(local-step,1,size),0)+
+                Inner.SampleLevel(LinearClamp,colorUV(local+float2(step.x,-step.y),1,size),0)+
+                Inner.SampleLevel(LinearClamp,colorUV(local+float2(-step.x,step.y),1,size),0));
+}
+[numthreads(8,8,1)]
+void Pack(uint3 id:SV_DispatchThreadID){
+    if(any(id.xy>=PackedSize))return;
+    const float2 uv=(float2(id.xy)+.5)/PackedSize;
+    const float2 local=focusUV(uv);
+    const float w=quadFocusWeight(local,Focus.zw-Focus.xy,Blend);
+    uint2 ow,iw;
+    Outer.GetDimensions(ow.x,ow.y);Inner.GetDimensions(iw.x,iw.y);
+    const bool focus=w>=.5;
+    const float4 color=focus?focusColor(local,iw):
+                              Outer.SampleLevel(LinearClamp,colorUV(uv,0,ow),0);
+    Output0[id.xy]=color;
+    Output1[id.xy]=color;
+    PackedDepth[id.xy]=focus?InnerDepth.Load(int3(pixel(local,3),0)):OuterDepth.Load(int3(pixel(uv,2),0));
+    // Game motion references the previous frame of its source view.
+    const float2 previous=focus?
+        lerp(PreviousFocus.xy,PreviousFocus.zw,local+InnerMotion.Load(int3(pixel(local,5),0))*MotionScale.zw):
+        uv+OuterMotion.Load(int3(pixel(uv,4),0))*MotionScale.xy;
+    PackedMotion[id.xy]=previous-uv;
+}
+#else
+float3 delta(float2 uv){
+    return Inner.SampleLevel(LinearClamp,uv,0).rgb-Outer.SampleLevel(LinearClamp,uv,0).rgb;
+}
+#ifdef JOINT_NR_PERIPH
+struct V {float4 position:SV_Position;float2 uv:TEXCOORD0;};
+V PeriphVS(uint id:SV_VertexID){
+    V v;v.uv=float2((id<<1)&2,id&2);
+    v.position=float4(v.uv*float2(2,-2)+float2(-1,1),0,1);return v;
+}
+Texture2D<float4> LimitHistory:register(t2);
+struct PeripheralBlend {float4 correction:SV_Target0;float4 gain:SV_Target1;};
+PeripheralBlend PeriphNativePS(V v){
+    const float gain=LimitEnabled?exp2(LimitHistory.SampleLevel(LinearClamp,v.uv,0).z):1;
+    // The blend unit applies gain to the existing HDR without sampling the RTV.
+    PeripheralBlend output;
+    output.correction=float4(delta(v.uv)*gain+.015*(gain-1),0);
+    output.gain=float4(gain,gain,gain,1);
+    return output;
+}
+#else
+[numthreads(8,8,1)]
+void Resolve(uint3 id:SV_DispatchThreadID){
+    if(all(id.xy<FocusSize)){
+        const float2 uv=lerp(Focus.xy,Focus.zw,(float2(id.xy)+.5)/FocusSize);
+        const float4 source=Output0[id.xy];
+        Output0[id.xy]=float4(source.rgb+delta(uv),source.a);
+    }
+}
+#endif
+#endif
+#endif
+)HLSL";
+}
