+bool init_joint_shaders(TransportDevice& device) {
+    if(device.joint_pack&&device.joint_resolve)return true;
+    using Microsoft::WRL::ComPtr;
+    const D3D_SHADER_MACRO resolve[]{{"JOINT_NR_RESOLVE","1"},{nullptr,nullptr}};
+    const D3D_SHADER_MACRO peripheral[]{{"JOINT_NR_RESOLVE","1"},{"JOINT_NR_PERIPH","1"},{nullptr,nullptr}};
+    const auto compile=[&](const char* entry,const char* profile,const D3D_SHADER_MACRO* defines,ID3DBlob** code){
+        ComPtr<ID3DBlob> errors;
+        const auto hr=D3DCompile(joint_nr::shader,sizeof(joint_nr::shader)-1,nullptr,defines,nullptr,entry,
+            profile,D3DCOMPILE_OPTIMIZATION_LEVEL3,0,code,&errors);
+        if(FAILED(hr)&&errors)trace_event("JOINT NR shader %s: %s",entry,static_cast<const char*>(errors->GetBufferPointer()));
+        return SUCCEEDED(hr);
+    };
+    D3D11_BUFFER_DESC constants{};
+    constants.ByteWidth=sizeof(joint_nr::Warp);
+    constants.BindFlags=D3D11_BIND_CONSTANT_BUFFER;
+    D3D11_SAMPLER_DESC sampler{};
+    sampler.Filter=D3D11_FILTER_MIN_MAG_LINEAR_MIP_POINT;
+    sampler.AddressU=sampler.AddressV=sampler.AddressW=D3D11_TEXTURE_ADDRESS_CLAMP;
+    sampler.ComparisonFunc=D3D11_COMPARISON_NEVER;
+    sampler.MaxAnisotropy=1;
+    sampler.MaxLOD=D3D11_FLOAT32_MAX;
+    D3D11_BLEND_DESC blend{};
+    blend.RenderTarget[0]={TRUE,D3D11_BLEND_ONE,D3D11_BLEND_SRC1_COLOR,D3D11_BLEND_OP_ADD,
+        D3D11_BLEND_ZERO,D3D11_BLEND_ONE,D3D11_BLEND_OP_ADD,
+        D3D11_COLOR_WRITE_ENABLE_RED|D3D11_COLOR_WRITE_ENABLE_GREEN|D3D11_COLOR_WRITE_ENABLE_BLUE};
+    D3D11_RASTERIZER_DESC raster{};raster.FillMode=D3D11_FILL_SOLID;raster.CullMode=D3D11_CULL_NONE;raster.DepthClipEnable=TRUE;
+    ComPtr<ID3DBlob> pack,resolveCode,vs,ps;
+    if(!compile("Pack","cs_5_0",nullptr,&pack)||
+       FAILED(device.device11->CreateComputeShader(pack->GetBufferPointer(),pack->GetBufferSize(),nullptr,&device.joint_pack))||
+       FAILED(device.device11->CreateDeferredContext(0,&device.joint_commands))||
+       FAILED(device.device11->CreateBuffer(&constants,nullptr,&device.joint_constants))||
+       FAILED(device.device11->CreateSamplerState(&sampler,&device.joint_sampler))||
+       !compile("Resolve","cs_5_1",resolve,&resolveCode)||
+       !compile("PeriphVS","vs_5_0",peripheral,&vs)||!compile("PeriphNativePS","ps_5_0",peripheral,&ps)||
+       FAILED(device.device11->CreateVertexShader(vs->GetBufferPointer(),vs->GetBufferSize(),nullptr,&device.joint_vs))||
+       FAILED(device.device11->CreatePixelShader(ps->GetBufferPointer(),ps->GetBufferSize(),nullptr,&device.joint_ps))||
+       FAILED(device.device11->CreateBlendState(&blend,&device.joint_blend))||
+       FAILED(device.device11->CreateRasterizerState(&raster,&device.joint_raster)))return false;
+    D3D12_DESCRIPTOR_RANGE ranges[]{
+        {D3D12_DESCRIPTOR_RANGE_TYPE_SRV,2,0,0,0},
+        {D3D12_DESCRIPTOR_RANGE_TYPE_UAV,1,0,0,2}
+    };
+    D3D12_ROOT_PARAMETER params[2]{};
+    params[0].ParameterType=D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    params[0].Constants={0,0,sizeof(joint_nr::Warp)/4};
+    params[1].ParameterType=D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[1].DescriptorTable={2,ranges};
+    D3D12_STATIC_SAMPLER_DESC sample{};
+    sample.Filter=D3D12_FILTER_MIN_MAG_LINEAR_MIP_POINT;
+    sample.AddressU=sample.AddressV=sample.AddressW=D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sample.ComparisonFunc=D3D12_COMPARISON_FUNC_NEVER;
+    sample.MaxAnisotropy=1;
+    sample.MaxLOD=D3D12_FLOAT32_MAX;
+    D3D12_ROOT_SIGNATURE_DESC root{2,params,1,&sample,D3D12_ROOT_SIGNATURE_FLAG_NONE};
+    ComPtr<ID3DBlob> blob;
+    if(FAILED(D3D12SerializeRootSignature(&root,D3D_ROOT_SIGNATURE_VERSION_1,&blob,nullptr))||
+       FAILED(device.device12->CreateRootSignature(0,blob->GetBufferPointer(),blob->GetBufferSize(),
+           IID_PPV_ARGS(&device.joint_signature))))return false;
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pipeline{};
+    pipeline.pRootSignature=device.joint_signature.Get();
+    pipeline.CS={resolveCode->GetBufferPointer(),resolveCode->GetBufferSize()};
+    return SUCCEEDED(device.device12->CreateComputePipelineState(&pipeline,IID_PPV_ARGS(&device.joint_resolve)));
+}
+
+bool pack_joint_nr(TransportDevice& device,JointNrTextures& textures,ID3D11DeviceContext* context,
+    const std::array<ID3D11Resource*,6>& sources,const std::array<joint_nr::Rect,6>& rects,
+    ID3D11ShaderResourceView* peripheral,joint_nr::Warp& warp) {
+    using Microsoft::WRL::ComPtr;
+    std::array<ComPtr<ID3D11ShaderResourceView>,6> reads;
+    std::array<ID3D11ShaderResourceView*,6> srvs{};
+    for(unsigned i=0;i<reads.size();++i){
+        ComPtr<ID3D11Texture2D> source;
+        if(FAILED(sources[i]->QueryInterface(IID_PPV_ARGS(&source))))return false;
+        D3D11_TEXTURE2D_DESC desc{};source->GetDesc(&desc);
+        const auto [x,y,w,h]=rects[i];
+        if(!w||!h||uint64_t(x)+w>desc.Width||uint64_t(y)+h>desc.Height||
+           desc.ArraySize!=1||desc.SampleDesc.Count!=1)return false;
+        if(i==0){
+            srvs[i]=peripheral;
+        }else{
+            D3D11_SHADER_RESOURCE_VIEW_DESC view{};
+            view.Format=(i==2||i==3)?depth_srv_format(desc.Format):desc.Format;
+            view.ViewDimension=D3D11_SRV_DIMENSION_TEXTURE2D;
+            view.Texture2D.MipLevels=1;
+            if(FAILED(device.device11->CreateShaderResourceView(source.Get(),&view,&reads[i])))return false;
+            srvs[i]=reads[i].Get();
+        }
+        warp.sourceRects[i]={float(x),float(y),float(w),float(h)};
+    }
+    const std::array targets{&textures.input,&textures.depth,&textures.motion,&textures.working};
+    std::array<ID3D11UnorderedAccessView*,4> outputs{};
+    for(unsigned i=0;i<outputs.size();++i)outputs[i]=targets[i]->packUav.Get();
+    auto* commands=device.joint_commands.Get();
+    auto* cb=device.joint_constants.Get();
+    auto* sampler=device.joint_sampler.Get();
+    commands->UpdateSubresource(cb,0,nullptr,&warp,0,0);
+    commands->CSSetShader(device.joint_pack.Get(),nullptr,0);
+    commands->CSSetConstantBuffers(0,1,&cb);
+    commands->CSSetSamplers(0,1,&sampler);
+    commands->CSSetShaderResources(0,static_cast<UINT>(srvs.size()),srvs.data());
+    commands->CSSetUnorderedAccessViews(0,static_cast<UINT>(outputs.size()),outputs.data(),nullptr);
+    const auto [width,height]=warp.packedSize;
+    commands->Dispatch((width+7)/8,(height+7)/8,1);
+    ComPtr<ID3D11CommandList> list;
+    if(FAILED(commands->FinishCommandList(FALSE,&list)))return false;
+    context->ExecuteCommandList(list.Get(),TRUE);
+    return true;
+}
+
+bool prepare_joint_nr(TransportDevice& device,TransportSlot& slot,TransportView& view,
+    ID3D11DeviceContext* context,const DlssFrameContract& focus,
+    const std::array<ID3D11Resource*,3>& inputs,const std::array<joint_nr::Rect,3>& rects,
+    bool reset,JointNrWork& work) {
+    const auto quad=quad_layer_view_snapshot();
+    const auto* role=quad_view_assignment(quad,focus.view_id,stereo_view_generation(focus.view_id));
+    if(!role||!role->focus||role->eye_index>=2)return false;
+    const auto frame=quad_app_frame();
+    const auto eye=role->eye_index;
+    const auto miss=[&](unsigned stage,const char* reason){
+        static unsigned logged[2]{};
+        const unsigned bit=1u<<stage;
+        if(!(logged[eye]&bit)){trace_event("JOINT NR skipped eye=%u reason=%s",eye,reason);logged[eye]|=bit;}
+        return false;
+    };
+    const auto nativeFrame=joint_nr::focusFrames[eye];
+    if(!nativeFrame)return miss(7,"same-frame Focus pass unavailable");
+    using Query=bool(__cdecl*)(uint64_t,int64_t,unsigned,float*,float*);
+    const auto layer=quad_view_module();
+    const auto locate=layer?reinterpret_cast<Query>(GetProcAddress(layer,"CheekyQuad_GetFocusSamplingV1")):nullptr;
+    std::array<float,4> inset{},blend{};
+    if(!locate||!locate(frame.session_generation,frame.predicted_display_time,eye,inset.data(),blend.data()))
+        return miss(0,"same-frame Focus projection unavailable");
+    const float w=inset[2],h=inset[3];
+    inset[2]+=inset[0];inset[3]+=inset[1];
+    if(!(w>0&&h>0&&inset[0]>=0&&inset[1]>=0&&inset[2]<=1&&inset[3]<=1&&blend[0]>0&&blend[1]>0))
+        return miss(1,"Focus projection outside periphery");
+    auto outer=joint_nr::take(eye,nativeFrame);
+    const auto& outerRender=outer.guideRects[0];
+    if(!outer.postColor)
+        return miss(2,"same-eye peripheral input unavailable");
+    if(view.joint_peripheral.texture!=outer.postColor.Get()){
+        TransportView::JointPeripheralViews peripheral;
+        peripheral.texture=outer.postColor.Get();
+        if(FAILED(device.device11->CreateRenderTargetView(peripheral.texture,nullptr,&peripheral.write))||
+           FAILED(device.device11->CreateShaderResourceView(peripheral.texture,nullptr,&peripheral.read)))
+            return miss(9,"native peripheral SR views unavailable");
+        view.joint_peripheral=std::move(peripheral);
+    }
+    const auto [width,height]=std::pair{focus.render_width,focus.render_height};
+    const auto [pw,ph]=std::pair{outerRender.width,outerRender.height};
+    auto& j=slot.joint;
+    if(!init_joint_shaders(device))return miss(3,"shader creation failed");
+    const auto ensure=[&](JointTexture& texture,const char* label,DXGI_FORMAT format){
+        if(texture.width!=pw||texture.height!=ph){texture.packUav.Reset();texture.readSrv.Reset();}
+        return create_shared_texture(device,label,pw,ph,format,D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,texture)&&
+            (texture.packUav||SUCCEEDED(device.device11->CreateUnorderedAccessView(texture.texture11,nullptr,&texture.packUav)));
+    };
+    if(!ensure(j.input,"joint NR input",DXGI_FORMAT_R16G16B16A16_FLOAT)||
+       !ensure(j.working,"joint NR working",DXGI_FORMAT_R16G16B16A16_FLOAT)||
+       !ensure(j.depth,"joint NR depth",DXGI_FORMAT_R32_FLOAT)||
+       !ensure(j.motion,"joint NR motion",DXGI_FORMAT_R16G16_FLOAT))return miss(4,"packed resource creation failed");
+    for(auto* tex:{&j.input,&j.working})if(!tex->readSrv&&FAILED(device.device11->CreateShaderResourceView(tex->texture11,nullptr,&tex->readSrv)))
+        return miss(8,"packed color shader resource view unavailable");
+    if(!j.descriptors){
+        D3D12_DESCRIPTOR_HEAP_DESC heap{D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,3,D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,0};
+        if(FAILED(device.device12->CreateDescriptorHeap(&heap,IID_PPV_ARGS(&j.descriptors))))return miss(5,"resolve descriptors failed");
+    }
+    reset=reset||view.joint_layout[2]<=view.joint_layout[0]||
+        view.joint_extent!=std::array{pw,ph}||view.joint_frame+1!=nativeFrame;
+    work={{inset,{outer.motionX/outerRender.width,outer.motionY/outerRender.height,
+                  focus.motion_vector_scale_x/width,focus.motion_vector_scale_y/height},
+           {pw,ph},{width,height},0,0,{},blend,reset?inset:view.joint_layout,{}},reset,eye,nativeFrame};
+    const std::array sources{static_cast<ID3D11Resource*>(outer.postColor.Get()),inputs[0],
+        static_cast<ID3D11Resource*>(outer.guides[0].Get()),inputs[1],
+        static_cast<ID3D11Resource*>(outer.guides[1].Get()),inputs[2]};
+    const std::array allRects{outer.postRect,rects[0],outer.guideRects[0],rects[1],outer.guideRects[1],rects[2]};
+    return pack_joint_nr(device,j,context,sources,allRects,view.joint_peripheral.read.Get(),work.warp)||
+        miss(6,"D3D11 source or pack rejected");
+}
+
+void resolve_joint_nr(TransportDevice& device,JointNrTextures& textures,const joint_nr::Warp& warp,ID3D12Resource* output) {
+    const auto increment=device.device12->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    auto cpu=textures.descriptors->GetCPUDescriptorHandleForHeapStart();
+    for(auto* read:{textures.input.resource12,textures.working.resource12}){
+        device.device12->CreateShaderResourceView(read,nullptr,cpu);cpu.ptr+=increment;
+    }
+    device.device12->CreateUnorderedAccessView(output,nullptr,nullptr,cpu);
+    auto* list=device.command_list12;
+    auto* heap=textures.descriptors.Get();
+    list->SetDescriptorHeaps(1,&heap);
+    list->SetComputeRootSignature(device.joint_signature.Get());
+    list->SetComputeRoot32BitConstants(0,sizeof(warp)/4,&warp,0);
+    list->SetComputeRootDescriptorTable(1,heap->GetGPUDescriptorHandleForHeapStart());
+    list->SetPipelineState(device.joint_resolve.Get());
+    list->Dispatch((warp.focusSize[0]+7)/8,(warp.focusSize[1]+7)/8,1);
+    D3D12_RESOURCE_BARRIER barrier{};barrier.Type=D3D12_RESOURCE_BARRIER_TYPE_UAV;barrier.UAV.pResource=output;
+    list->ResourceBarrier(1,&barrier);
+}
+
+bool evaluate_joint_nr(TransportDevice& device,TransportSlot& slot,TransportView& view,const JointNrWork& work,
+    const DlssNrFrame& focus,const Settings& settings) {
+    auto* list=device.command_list12;
+    auto& j=slot.joint;
+    for(auto* t:{&j.input,&j.depth,&j.motion})
+        transition(list,t->resource12,D3D12_RESOURCE_STATE_COMMON,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    transition(list,j.working.resource12,D3D12_RESOURCE_STATE_COMMON,D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    const auto [pw,ph]=work.warp.packedSize;
+    DlssNrFrame packed{};
+    packed.view_id=focus.view_id;packed.route=focus.route;packed.command_list=list;
+    packed.color=j.working.resource12;packed.depth=j.depth.resource12;packed.motion_vectors=j.motion.resource12;
+    packed.input_width=packed.output_width=packed.depth_width=packed.motion_width=packed.processing_width=pw;
+    packed.input_height=packed.output_height=packed.depth_height=packed.motion_height=packed.processing_height=ph;
+    packed.depth_inverted=focus.depth_inverted;packed.create_flags=focus.create_flags|dlss_feature_flag_mv_low_res;
+    packed.reset=work.reset;packed.motion_vectors_jittered=focus.motion_vectors_jittered;
+    packed.jitter_uv_x=focus.jitter_uv_x*(work.warp.focus[2]-work.warp.focus[0]);
+    packed.jitter_uv_y=focus.jitter_uv_y*(work.warp.focus[3]-work.warp.focus[1]);
+    packed.result_weight=focus.result_weight;
+    packed.active_working_scale=focus.active_working_scale;
+    const bool evaluated=evaluate_dlss_nr(packed,settings);
+    if(evaluated){
+        transition(list,j.working.resource12,D3D12_RESOURCE_STATE_UNORDERED_ACCESS,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        resolve_joint_nr(device,j,work.warp,focus.color);
+        view.joint_layout=work.warp.focus;
+        view.joint_extent={pw,ph};
+        view.joint_frame=work.nativeFrame;
+    }
+    transition(list,j.working.resource12,evaluated?D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE:
+        D3D12_RESOURCE_STATE_UNORDERED_ACCESS,D3D12_RESOURCE_STATE_COMMON);
+    for(auto* t:{&j.input,&j.depth,&j.motion})
+        transition(list,t->resource12,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,D3D12_RESOURCE_STATE_COMMON);
+    return evaluated;
+}
+
+bool prepare_joint_stability(TransportDevice& device,TransportView::JointStabilityHistory& history,
+                             const std::array<unsigned,2>& extent) {
+    using Microsoft::WRL::ComPtr;
+    if(!device.joint_stability_bounds_write){
+        const D3D_SHADER_MACRO defines[]{{"JOINT_NR_LIMIT","1"},{nullptr,nullptr}};
+        const auto compile=[&](const char* entry,ID3D11ComputeShader** shader){
+            ComPtr<ID3DBlob> code,errors;
+            const auto result=D3DCompile(joint_nr::shader,sizeof(joint_nr::shader)-1,nullptr,defines,nullptr,entry,
+                "cs_5_0",D3DCOMPILE_OPTIMIZATION_LEVEL3,0,&code,&errors);
+            if(FAILED(result)&&errors)trace_event("JOINT NR shader %s: %s",entry,static_cast<const char*>(errors->GetBufferPointer()));
+            return SUCCEEDED(result)&&SUCCEEDED(device.device11->CreateComputeShader(
+                code->GetBufferPointer(),code->GetBufferSize(),nullptr,shader));
+        };
+        D3D11_BUFFER_DESC desc{};
+        desc.ByteWidth=desc.StructureByteStride=sizeof(float)*4;
+        desc.MiscFlags=D3D11_RESOURCE_MISC_BUFFER_STRUCTURED;
+        desc.BindFlags=D3D11_BIND_SHADER_RESOURCE|D3D11_BIND_UNORDERED_ACCESS;
+        ComPtr<ID3D11Buffer> buffer;
+        if(!compile("GuideLimit",&device.joint_stability_guide)||
+           !compile("ApplyLimit",&device.joint_stability_apply)||
+           FAILED(device.device11->CreateBuffer(&desc,nullptr,&buffer))||
+           FAILED(device.device11->CreateShaderResourceView(buffer.Get(),nullptr,&device.joint_stability_bounds_read))||
+           FAILED(device.device11->CreateUnorderedAccessView(buffer.Get(),nullptr,&device.joint_stability_bounds_write)))
+            return false;
+    }
+    if(history.extent==extent)return true;
+    TransportView::JointStabilityHistory next;
+    D3D11_TEXTURE2D_DESC desc{};
+    desc.Width=extent[0];desc.Height=extent[1];desc.MipLevels=desc.ArraySize=desc.SampleDesc.Count=1;
+    desc.Format=DXGI_FORMAT_R16G16B16A16_FLOAT;
+    desc.BindFlags=D3D11_BIND_SHADER_RESOURCE|D3D11_BIND_UNORDERED_ACCESS;
+    for(unsigned i=0;i<next.read.size();++i){
+        ComPtr<ID3D11Texture2D> image;
+        if(FAILED(device.device11->CreateTexture2D(&desc,nullptr,&image))||
+           FAILED(device.device11->CreateShaderResourceView(image.Get(),nullptr,&next.read[i]))||
+           FAILED(device.device11->CreateUnorderedAccessView(image.Get(),nullptr,&next.write[i])))return false;
+    }
+    next.extent=extent;
+    history=std::move(next);
+    return true;
+}
+
+bool apply_joint_peripheral(TransportDevice& device,TransportSlot& slot,TransportView& view,
+                            ID3D11DeviceContext* context,const JointNrWork& work) {
+    using Microsoft::WRL::ComPtr;
+    // Queue the additive HDR write after the existing D3D12 completion wait.
+    const auto commands=device.joint_commands.Get();
+    auto* constants=device.joint_constants.Get();
+    auto* sampler=device.joint_sampler.Get();
+    auto* target=view.joint_peripheral.write.Get();
+    auto warp=work.warp;
+    auto& history=view.joint_stability;
+    const bool stability=joint_nr::frameStability;
+    auto& motion=slot.joint.motion;
+    if(stability&&prepare_joint_stability(device,history,warp.packedSize)&&
+       (motion.readSrv||SUCCEEDED(device.device11->CreateShaderResourceView(motion.texture11,nullptr,&motion.readSrv)))){
+        warp.limitEnabled=1;
+        warp.limitSeed=work.reset||history.frame+1!=work.nativeFrame;
+    }else if(stability){
+        static bool logged=false;
+        if(!logged){trace_event("JOINT NR stability resources unavailable");logged=true;}
+    }else if(history.extent[0]){
+        history={};
+    }
+    const auto back=1-history.front;
+    ID3D11ShaderResourceView* reads[]{slot.joint.input.readSrv.Get(),slot.joint.working.readSrv.Get(),
+        warp.limitEnabled?history.read[back].Get():nullptr};
+    const auto& rect=warp.sourceRects[0];
+    const D3D11_VIEWPORT viewport{rect[0],rect[1],rect[2],rect[3],0,1};
+    commands->ClearState();
+    commands->UpdateSubresource(constants,0,nullptr,&warp,0,0);
+    if(warp.limitEnabled){
+        ID3D11ShaderResourceView* inputs[]{reads[0],reads[1],history.read[history.front].Get(),
+            motion.readSrv.Get(),view.joint_peripheral.read.Get(),nullptr};
+        commands->CSSetConstantBuffers(0,1,&constants);
+        commands->CSSetSamplers(0,1,&sampler);
+        commands->CSSetShaderResources(0,6,inputs);
+        if(!warp.limitSeed){
+            auto* bounds=device.joint_stability_bounds_write.Get();
+            commands->CSSetUnorderedAccessViews(1,1,&bounds,nullptr);
+            commands->CSSetShader(device.joint_stability_guide.Get(),nullptr,0);
+            commands->Dispatch(1,1,1);
+        }
+        ID3D11UnorderedAccessView* output[]{history.write[back].Get(),nullptr};
+        auto* bounds=device.joint_stability_bounds_read.Get();
+        commands->CSSetUnorderedAccessViews(0,2,output,nullptr);
+        commands->CSSetShaderResources(5,1,&bounds);
+        commands->CSSetShader(device.joint_stability_apply.Get(),nullptr,0);
+        commands->Dispatch((warp.packedSize[0]+7)/8,(warp.packedSize[1]+7)/8,1);
+        // End the source SRV read before writing the same HDR subresource through its RTV.
+        commands->ClearState();
+    }
+    commands->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    commands->RSSetState(device.joint_raster.Get());
+    commands->RSSetViewports(1,&viewport);
+    commands->OMSetRenderTargets(1,&target,nullptr);
+    commands->OMSetBlendState(device.joint_blend.Get(),nullptr,~0u);
+    commands->VSSetShader(device.joint_vs.Get(),nullptr,0);
+    commands->PSSetShader(device.joint_ps.Get(),nullptr,0);
+    commands->PSSetConstantBuffers(0,1,&constants);
+    commands->PSSetSamplers(0,1,&sampler);
+    commands->PSSetShaderResources(0,3,reads);
+    commands->Draw(3,0);
+    ComPtr<ID3D11CommandList> list;
+    if(FAILED(commands->FinishCommandList(FALSE,&list)))return false;
+    context->ExecuteCommandList(list.Get(),TRUE);
+    if(warp.limitEnabled){
+        history.front=back;
+        history.frame=work.nativeFrame;
+    }
+    return true;
+}
