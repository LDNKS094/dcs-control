+void release_joint_textures(JointNrTextures& textures) noexcept {
+    for(auto* texture:{&textures.input,&textures.working,&textures.depth,&textures.motion}){
+        texture->packUav.Reset();
+        texture->readSrv.Reset();
+        release_shared_texture(*texture);
+    }
+    textures.descriptors.Reset();
+}
