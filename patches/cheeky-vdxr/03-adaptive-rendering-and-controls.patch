+#pragma once
+
+#include "quad_nr_transition.hpp"
+#include "../shared/cheeky_quad_views.h"
+
+namespace cheeky::foveated_dlss {
+
+struct QuadQualityTargets {
+    bool prepare_sr{}, low_sr{};
+    QuadNrQuality nr{QuadNrQuality::configured};
+};
+
+class QuadQualityControl {
+public:
+    QuadQualityTargets update(std::uint64_t now, const CheekyQuadQualitySampleV1& sample,
+                              unsigned sr_trigger, unsigned nr_trigger, bool nr_half_available,
+                              bool sr_ready) noexcept {
+        sr_.set_trigger(sr_trigger);
+        nr_.set_trigger(nr_trigger);
+        if (!sr_trigger) {
+            targets_.prepare_sr = targets_.low_sr = false;
+            release_after_ = 0;
+            sr_observe_after_ = 0;
+        }
+        if (!nr_trigger) targets_.nr = QuadNrQuality::configured;
+        if (targets_.nr == QuadNrQuality::half && !nr_half_available)
+            targets_.nr = QuadNrQuality::configured;
+
+        if (!sample.recorded_ms || now - sample.recorded_ms > 500) {
+            sr_.reset();
+            nr_.reset();
+            release_after_ = 0;
+            return targets_;
+        }
+        if (sample.recorded_ms == last_sample_) return targets_;
+        if (sample.recorded_ms - last_sample_ > 500) {
+            sr_.reset();
+            nr_.reset();
+            release_after_ = 0;
+        }
+        last_sample_ = sample.recorded_ms;
+
+        const auto sr = sr_.observe(sample);
+        const auto nr = nr_.observe(sample);
+        // Even a short return to pressure interrupts a pending resource release.
+        if (!sr.headroom || targets_.low_sr) release_after_ = 0;
+        else if (targets_.prepare_sr && sr.recover) {
+            if (!release_after_) release_after_ = now + sr_retention_ms;
+            if (now >= release_after_) targets_.prepare_sr = false;
+        }
+        if (now >= sr_observe_after_) {
+            if (sr.prepare) targets_.prepare_sr = true;
+            if (sr.reduce && !targets_.low_sr && sr_ready) {
+                targets_.low_sr = true;
+                sr_observe_after_ = now + 1000;
+                sr_.reset();
+            } else if (sr.recover && targets_.low_sr) {
+                targets_.low_sr = false;
+                sr_observe_after_ = now + 1000;
+                sr_.reset();
+                release_after_ = now + sr_retention_ms;
+            }
+        }
+        if (now >= nr_observe_after_) {
+            // Choose from the tier actually in use. A pending fade-out can
+            // reverse direction without consuming another tier.
+            if (nr.reduce) {
+                targets_.nr = nr_half_available && active_nr_ == QuadNrQuality::configured
+                    ? QuadNrQuality::half : QuadNrQuality::bypass;
+            } else if (nr.recover) {
+                targets_.nr = nr_half_available && active_nr_ == QuadNrQuality::bypass
+                    ? QuadNrQuality::half : QuadNrQuality::configured;
+            }
+        }
+        return targets_;
+    }
+
+    void nr_switched(std::uint64_t now, QuadNrQuality active) noexcept {
+        active_nr_ = active;
+        nr_observe_after_ = now + 1000;
+        nr_.reset();
+    }
+
+    const QuadQualityTargets& targets() const noexcept { return targets_; }
+
+private:
+    static constexpr std::uint64_t sr_retention_ms = 8000;
+    struct Band {
+        bool prepare{}, reduce{}, recover{}, headroom{};
+    };
+
+    struct Threshold {
+        unsigned trigger{};
+        std::uint64_t prepare_since{}, reduce_since{}, recover_since{};
+
+        void reset() noexcept { prepare_since = reduce_since = recover_since = 0; }
+        void set_trigger(unsigned value) noexcept {
+            if (trigger != value) reset();
+            trigger = value;
+        }
+        Band observe(const CheekyQuadQualitySampleV1& sample) noexcept {
+            if (!trigger) return {};
+            const bool pressure = sample.gpu_load >= 0.90;
+            const double upper = trigger + 5.0;
+            const bool headroom = sample.gpu_load <= 0.85 && sample.output_percent > upper;
+            const auto tick = sample.recorded_ms;
+            return {sustained(pressure && sample.output_percent <= upper, tick, 500, prepare_since),
+                    sustained(pressure && sample.output_percent < trigger, tick, 500, reduce_since),
+                    sustained(headroom, tick, 3000, recover_since), headroom};
+        }
+        static bool sustained(bool condition, std::uint64_t tick, std::uint64_t time,
+                              std::uint64_t& since) noexcept {
+            if (!condition) since = 0;
+            else if (!since) since = tick;
+            return since && tick - since >= time;
+        }
+    };
+
+    Threshold sr_, nr_;
+    QuadQualityTargets targets_;
+    QuadNrQuality active_nr_{QuadNrQuality::configured};
+    std::uint64_t last_sample_{}, sr_observe_after_{}, nr_observe_after_{}, release_after_{};
+};
