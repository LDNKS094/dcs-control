diff --git a/src/quad_nr_transition.hpp b/src/quad_nr_transition.hpp
new file mode 100644
index 0000000..3fc4330
--- /dev/null
+++ b/src/quad_nr_transition.hpp
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <cstdint>
+
+namespace cheeky::foveated_dlss {
+
+enum class QuadNrQuality { configured, half, bypass };
+
+struct QuadNrSelection {
+    float active_scale{};
+    float result_weight{1.0F};
+    bool bypass{};
+};
+
+class QuadNrTransition {
+public:
+    QuadNrSelection update(std::uint64_t session, std::int64_t frame,
+                           QuadNrQuality requested, float configured_scale) noexcept {
+        if (session != session_) {
+            session_ = session;
+            frame_ = 0;
+            active_ = QuadNrQuality::configured;
+            weight_ = steps;
+        }
+        // Both center views use the decision already made for this application frame.
+        if (frame != 0 && frame != frame_) {
+            frame_ = frame;
+            const auto target = requested == QuadNrQuality::half && configured_scale <= 0.5F
+                ? QuadNrQuality::bypass : requested;
+            if (active_ != target) {
+                weight_ -= weight_ >= fade_out_step ? fade_out_step : weight_;
+                if (weight_ == 0) active_ = target;
+            } else if (active_ != QuadNrQuality::bypass && weight_ < steps) {
+                ++weight_;
+            }
+        }
+        return {active_ == QuadNrQuality::half ? 0.5F : 0.0F,
+                static_cast<float>(weight_) / steps, active_ == QuadNrQuality::bypass};
+    }
+
+    QuadNrQuality active() const noexcept { return active_; }
+
+private:
+    static constexpr unsigned steps = 8;
+    static constexpr unsigned fade_out_step = 2;
+    std::uint64_t session_{};
+    std::int64_t frame_{};
+    QuadNrQuality active_{QuadNrQuality::configured};
+    unsigned weight_{steps};
+};
+
+} // namespace cheeky::foveated_dlss
