diff --git a/openxr_layer/quad_head_focus.hpp b/openxr_layer/quad_head_focus.hpp
new file mode 100644
index 0000000..d804462
--- /dev/null
+++ b/openxr_layer/quad_head_focus.hpp
@@ -0,0 +1,62 @@
+#pragma once
+#include "../shared/quad_focus.hpp"
+#include <openxr/openxr.h>
+#include <array>
+#include <cmath>
+#include <numbers>
+
+namespace cheeky::quad_capture {
+
+using FocusShift = std::array<float,2>;
+
+class HeadFocus {
+    FocusShift reference{};
+    XrTime time{};
+    XrSpace space{};
+    std::uint64_t revision{};
+    FocusShift shift{};
+
+    static float difference(float value, float reference) {
+        return std::remainder(value-reference,360.f);
+    }
+    static float deadzone(float value,float radius) {
+        return std::copysign(std::max(0.f,std::abs(value)-radius),value);
+    }
+    static FocusShift angles(const std::array<XrView,2>& views) {
+        // Average the forward directions so canted eye poses share one target.
+        float x=0.f,y=0.f,z=0.f;
+        for (const auto& view:views) {
+            const auto& q=view.pose.orientation;
+            x-=2.f*(q.x*q.z+q.w*q.y);
+            y+=2.f*(q.w*q.x-q.y*q.z);
+            z+=2.f*(q.x*q.x+q.y*q.y)-1.f;
+        }
+        constexpr float degrees=180.f/std::numbers::pi_v<float>;
+        return {std::atan2(x,-z)*degrees,std::atan2(y,std::hypot(x,z))*degrees};
+    }
+
+public:
+    FocusShift update(const std::array<XrView,2>& views,const XrViewLocateInfo& info,
+        const QuadFocusSettings& settings,std::uint64_t next_revision) {
+        if (!settings.head_offset) {
+            *this={};
+            return {};
+        }
+        const std::array params{settings.horizontal,settings.vertical};
+        const auto current=angles(views);
+        const bool rebase=!time||space!=info.space||revision!=next_revision;
+        if (!rebase&&info.displayTime<=time) return shift;
+        if (rebase) reference=current;
+        for (unsigned axis=0;axis<2;++axis) {
+            const auto& p=params[axis];
+            const float relative=deadzone(difference(current[axis],reference[axis]),p.deadzone);
+            shift[axis]=p.bias+relative*p.angle_gain;
+        }
+        time=info.displayTime;
+        space=info.space;
+        revision=next_revision;
+        return shift;
+    }
+};
+
+} // namespace cheeky::quad_capture
