+inline std::array<std::uint32_t,2> initial_focus_render_percent() {
+    const auto defaults=current_focus().settings;
+    wchar_t executable[MAX_PATH]{};
+    const auto length=GetModuleFileNameW(nullptr,executable,MAX_PATH);
+    if(!length||length>=MAX_PATH)return {defaults.width,defaults.height};
+    // DCS can enumerate view extents before the standalone host loads the runtime.
+    const auto config=std::filesystem::path(executable).parent_path()/L"CheekyFoveatedDLSS"/L"CheekyFoveatedDLSS.ini";
+    const auto percent=[&](const wchar_t* key,std::uint32_t fallback) {
+        const auto value=GetPrivateProfileIntW(L"CheekyFoveatedDLSS",key,fallback,config.c_str());
+        return static_cast<std::uint32_t>(std::clamp(static_cast<int>(value),25,100));
+    };
+    return {percent(L"QuadFocusWidth",defaults.width),percent(L"QuadFocusHeight",defaults.height)};
+}
