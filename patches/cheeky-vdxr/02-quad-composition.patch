+void check_quad_head_focus() {
+    using namespace cheeky::quad_capture;
+    HeadFocus tracking;
+    QuadFocusSettings settings;
+    settings.head_offset=true;
+    settings.horizontal.angle_gain=settings.vertical.angle_gain=.25f;
+    XrViewLocateInfo info{XR_TYPE_VIEW_LOCATE_INFO};
+    info.displayTime=1;
+    std::array<XrView,2> views{};
+    for(auto& view:views){
+        view.pose.orientation.w=1.f;
+        view.fov={-.7f,.7f,.7f,-.7f};
+    }
+    check(tracking.update(views,info,settings,0)==FocusShift{},"Head focus starts centered");
+    const float yaw=-.2f,pitch=-.2f;
+    const XrQuaternionf turned{std::sin(pitch)*std::cos(yaw),std::sin(yaw)*std::cos(pitch),
+        -std::sin(pitch)*std::sin(yaw),std::cos(yaw)*std::cos(pitch)};
+    for(auto& view:views)view.pose.orientation=turned;
+    info.displayTime+=100'000'000;
+    const auto moving=tracking.update(views,info,settings,0);
+    check(moving[0]>4.f&&moving[1]<-4.f,"Head focus maps signed pitch and yaw");
+    HeadFocus slower;
+    auto late=info;
+    late.displayTime=1;
+    for(auto& view:views)view.pose.orientation={0,0,0,1};
+    slower.update(views,late,settings,0);
+    for(auto& view:views)view.pose.orientation=turned;
+    late.displayTime+=500'000'000;
+    check(slower.update(views,late,settings,0)==moving,"Head focus responds to angle independently of turn duration");
+    info.displayTime+=2'000'000'000;
+    const auto still=tracking.update(views,info,settings,0);
