+    compositor.focus_settings.feather=0;
+    for(auto& draw:draws)draw.params[15]=0;
+    compositor.color_match.record(compositor.deferred.Get(),compositor.constants.Get(),compositor.sampler.Get(),draws);
+    for(unsigned eye=0;eye<2;++eye)check(compositor.record_draw(eye,draws[eye],targets[eye].Get()),"Draw matched hard seams");
+    ComPtr<ID3D11CommandList> hard_seams;
+    check(SUCCEEDED(compositor.deferred->FinishCommandList(FALSE,&hard_seams)),"Hard seam command list");
+    context->ExecuteCommandList(hard_seams.Get(),TRUE);
+    check(pixel_at(0,shadow,top-4,0)>levels[0]&&pixel_at(0,width/2,height/2,0)==center[0],"Color correction works with zero feather");
+
+    std::cout<<"PASS stereo RGB color match, disabled match and zero feather\n";
+}
 }
