diff --git a/tests/openxr_binding/quad_native_pool_validation.hpp b/tests/openxr_binding/quad_native_pool_validation.hpp
new file mode 100644
index 0000000..28ddb01
--- /dev/null
+++ b/tests/openxr_binding/quad_native_pool_validation.hpp
@@ -0,0 +1,81 @@
+// Exercise the production native atlas pool with actual D3D11 textures.
+void quad_native_pool_validation() {
+    using Microsoft::WRL::ComPtr;
+    ComPtr<ID3D11Device> device;ComPtr<ID3D11DeviceContext> context;
+    check(SUCCEEDED(D3D11CreateDevice(nullptr,D3D_DRIVER_TYPE_WARP,nullptr,0,nullptr,0,
+        D3D11_SDK_VERSION,&device,nullptr,&context)),"Native atlas test device");
+    cheeky::quad_capture::QuadFg11 atlas(device.Get());atlas.enable(true,true);
+    std::array<ComPtr<ID3D11Texture2D>,4> depth,motion;
+    CheekyQuadViewsV1 roles{};roles.active=1;roles.status=2;roles.revision=1;
+    std::array<XrCompositionLayerProjectionView,4> views{};
+    XrCompositionLayerProjection projection{XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+    projection.viewCount=4;projection.views=views.data();
+    for(unsigned i=0;i<4;++i){
+        const unsigned size=i<2?64:32;
+        D3D11_TEXTURE2D_DESC desc{};desc.Width=desc.Height=size;desc.MipLevels=desc.ArraySize=1;
+        desc.SampleDesc.Count=1;desc.Usage=D3D11_USAGE_DEFAULT;desc.BindFlags=D3D11_BIND_SHADER_RESOURCE;
+        desc.Format=DXGI_FORMAT_R32_FLOAT;
+        std::vector<float> depths(size*size,i<2?.25f:.75f);
+        D3D11_SUBRESOURCE_DATA initial{depths.data(),size*UINT(sizeof(float)),0};
+        check(SUCCEEDED(device->CreateTexture2D(&desc,&initial,&depth[i])),"Native atlas input depth");
+        desc.Format=DXGI_FORMAT_R32G32_FLOAT;
+        std::vector<std::array<float,2>> vectors(size*size,i<2?std::array{.125f,-.25f}:std::array{.5f,-.125f});
+        initial={vectors.data(),size*2*UINT(sizeof(float)),0};
+        check(SUCCEEDED(device->CreateTexture2D(&desc,&initial,&motion[i])),"Native atlas input motion");
+        roles.views[i].dlss_view=i+1;roles.views[i].registration_generation=1;
+        views[i].type=XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW;
+        views[i].subImage.imageRect.extent={int(size),int(size)};
+    }
+    const std::array<std::array<float,4>,2> insets{{{.25f,.25f,.5f,.5f},{.25f,.25f,.5f,.5f}}};
+    unsigned method=cheeky_fg_hybrid_base;
+    auto build=[&](uint64_t forget_generation=0){
+        for(unsigned i=0;i<4;++i){
+            const unsigned size=i<2?64:32;
+            CheekyQuadFgSourceV1 input;input.context=context.Get();input.motion=motion[i].Get();
+            if(method!=cheeky_fg_hybrid_base)input.depth=depth[i].Get();
+            input.generation=1;auto& g=input.meta;g.feature=i+1;g.configuration=1;
+            g.width=g.height=g.depth_width=g.depth_height=g.motion_width=g.motion_height=size;
+            g.center_method=method;g.configuration=method;
+            g.motion_scale_x=g.motion_scale_y=float(size);
+            check(atlas.observe(input),"Native atlas observes each source once");
+        }
+        if(forget_generation)atlas.forget(roles.views[0].dlss_view,forget_generation);
+        // This fixture has no Present/OpenXR submission to flush the immediate context.
+        auto result=atlas.build_native(roles,projection,insets);atlas.finish();context->Flush();return result;
+    };
+    std::array<cheeky::quad_capture::QuadFg11::NativeResult,4> held;
+    std::array<ID3D11Texture2D*,4> identities{};
+    for(unsigned i=0;i<held.size();++i){
+        held[i]=build();check(held[i].valid&&held[i].lease,"Native atlas obtains leased pool slot");
+        check(!held[i].depth[0]&&!held[i].depth[1],"Hybrid with depth off builds no depth atlas");
+        identities[i]=held[i].motion[0].Get();
+        for(unsigned j=0;j<i;++j)check(identities[i]!=identities[j],"Native atlas preserves busy slots");
+    }
+    check(!build().valid,"Native atlas returns unavailable while all four slots are leased");
+    held[0]={};
+    for(unsigned iteration=0;iteration<100;++iteration){
+        auto next=build();check(next.valid&&next.motion[0].Get()==identities[0],
+            "Native atlas reuses the retired slot instead of allocating every frame");
+    }
+    for(auto& item:held)item={};
+    method=cheeky_fg_hybrid_base+2;
+    auto guided=build();
+    check(guided.valid&&guided.depth[0]&&guided.depth[1],"Enabling splat restores the depth atlas");
+    D3D11_TEXTURE2D_DESC desc{};guided.motion[0]->GetDesc(&desc);
+    check(desc.Format==DXGI_FORMAT_R32G32_FLOAT,"Native Quad motion uses RG32_FLOAT");
+    desc.Usage=D3D11_USAGE_STAGING;desc.BindFlags=0;desc.CPUAccessFlags=D3D11_CPU_ACCESS_READ;
+    ComPtr<ID3D11Texture2D> staging;check(SUCCEEDED(device->CreateTexture2D(&desc,nullptr,&staging)),"Native atlas readback");
+    context->CopyResource(staging.Get(),guided.motion[0].Get());
+    D3D11_MAPPED_SUBRESOURCE read{};
+    check(SUCCEEDED(context->Map(staging.Get(),0,D3D11_MAP_READ,0,&read)),"Native atlas map");
+    const auto* wide=static_cast<const float*>(read.pData);
+    const auto* center=reinterpret_cast<const float*>(static_cast<const char*>(read.pData)+32*read.RowPitch)+64;
+    check(wide[0]==.125f&&wide[1]==-.25f&&center[0]==.25f&&center[1]==-.0625f,
+        "Both motion components survive wide/center atlas mapping");
+    context->Unmap(staging.Get(),0);
+    check(build(2).valid,"Retiring an unrelated generation keeps the active source");
+    check(!build(1).valid,"Retiring the active generation drops its snapshot before assembly");
+    check(build().valid,"Quad source slots can be reused after retirement");
+    atlas.enable(false);atlas.finish();context->Flush();
+    std::cout<<"PASS native Quad atlas: optional depth, RG32 motion pixels, bounded leases and slot reuse\n";
+}
