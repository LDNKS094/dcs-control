diff --git a/shared/quad_blend_shader.hpp b/shared/quad_blend_shader.hpp
new file mode 100644
index 0000000..c69518c
--- /dev/null
+++ b/shared/quad_blend_shader.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+// Keep color, projected UI and geometry guides on the same focus boundary.
+#define CHEEKY_QUAD_BLEND_HLSL R"HLSL(
+float quadFocusDistance(float2 local, float2 size, float radius) {
+    float2 q = abs(local - 0.5) * size - size * 0.5 + radius;
+    return radius - (length(max(q, 0.0)) + min(max(q.x, q.y), 0.0));
+}
+float quadFocusWeight(float2 local, float2 insetSize, float4 blend) {
+    float2 size = insetSize * blend.xy;
+    if (blend.z < 0.0) {
+        float2 edge = min(local, 1.0 - local) * size;
+        return saturate(min(edge.x, edge.y) * 0.5);
+    }
+    float inside = quadFocusDistance(local, size, blend.z);
+    return blend.w > 0.0 ? smoothstep(0.0, blend.w, inside) : step(0.0, inside);
+}
+)HLSL"
diff --git a/shared/quad_focus.hpp b/shared/quad_focus.hpp
new file mode 100644
index 0000000..44b3942
--- /dev/null
+++ b/shared/quad_focus.hpp
@@ -0,0 +1,35 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+struct QuadFocusAxis {
+    float bias{};
+    float angle_gain{.15f};
+    float deadzone{1.f};
+};
+
+inline constexpr float quad_focus_min_distance_m=.25f,quad_focus_max_distance_m=10.f;
+inline constexpr float quad_focus_max_bias_deg=45.f;
+
+struct QuadFocusSettings {
+    bool custom_blend{};
+    std::uint32_t width{50}, height{50};
+    std::uint32_t radius{10}, feather{10};
+    bool color_match{};
+    bool head_offset{};
+    bool match_stereo_borders{};
+    QuadFocusAxis horizontal, vertical;
+    float stereo_distance_m{1.f};
+};
+using QuadFocusBlend = std::array<float,4>;
+inline constexpr QuadFocusBlend original_quad_blend{0.f,0.f,-1.f,0.f};
+
+// xy are the output dimensions in pixels; zw are radius and feather in pixels.
+// A negative radius selects the original two-pixel linear blend.
+inline QuadFocusBlend quad_focus_blend(const QuadFocusSettings& settings,
+    const std::array<float,4>& inset, unsigned width, unsigned height) noexcept {
+    const auto short_side = std::min(inset[2]*width,inset[3]*height);
+    return {float(width),float(height),settings.custom_blend?settings.radius*.01f*short_side:-1.f,
+        settings.feather*.01f*short_side};
+}
