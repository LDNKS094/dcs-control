+inline constexpr char color_match_shader[]=CHEEKY_QUAD_BLEND_HLSL R"HLSL(
+Texture2DArray<float4> Context:register(t0);
+Texture2DArray<float4> Focus:register(t1);
+Texture2DArray<float4> RightContext:register(t3);
+Texture2DArray<float4> RightFocus:register(t4);
+Texture1DArray<float4> Gains:register(t5);
+Texture2DArray<float4> GridInput:register(t6);
+Texture2DArray<float4> LocalCurves:register(t7);
+Texture2DArray<float4> PreviousCurves:register(t8);
+RWTexture2DArray<float4> GridOutput:register(u1);
+RWTexture1DArray<float4> ToneGainOutput:register(u2);
+RWTexture2DArray<float4> CurveOutput:register(u3);
+SamplerState Linear:register(s0);
+cbuffer Params:register(b0){float4 ContextUV;float4 FocusUV;float4 Inset;float4 Blend;};
+cbuffer RightParams:register(b2){float4 RightContextUV;float4 RightFocusUV;float4 RightInset;float4 RightBlend;float CurveHistoryWeight;};
+struct V{float4 p:SV_Position;float2 uv:TEXCOORD0;};
+
+static const uint MaxGrid=64;
+
+uint2 gridSize(float2 size) {
+    return max(uint2(1,1),uint2(round(size*(MaxGrid/max(size.x,size.y)))));
+}
+
+float2 eyeSize(bool right) {
+    return right?RightInset.zw*RightBlend.xy:Inset.zw*Blend.xy;
+}
+
+float2 pairWeights(float i,float lo,float hi) {
+    const float2 starts=float2(i,i+1.0);
+    return max(0.0,min(starts+1.0,hi)-max(starts,lo));
+}
+
+// A weighted bilinear read exactly combines up to four texels. Fractional
+// texel coverage keeps the two views on the same angular box footprint.
+float3 boxAverage(Texture2DArray<float4> image,float2 lo,float2 hi) {
+    uint width,height,layers;
+    image.GetDimensions(width,height,layers);
+    const float2 size=float2(width,height);
+    lo*=size;hi*=size;
+    float3 sum=0.0;
+    float total=0.0;
+    [loop]for(float y=floor(lo.y);y<hi.y;y+=2.0){
+        const float2 wy=pairWeights(y,lo.y,hi.y);
+        const float sy=wy.x+wy.y;
+        const float v=(y+.5+wy.y/sy)/size.y;
+        [loop]for(float x=floor(lo.x);x<hi.x;x+=2.0){
+            const float2 wx=pairWeights(x,lo.x,hi.x);
+            const float sx=wx.x+wx.y;
+            const float u=(x+.5+wx.y/sx)/size.x;
+            const float weight=sx*sy;
+            sum+=image.SampleLevel(Linear,float3(u,v,0),0).rgb*weight;
+            total+=weight;
+        }
+    }
+    return max(0.0,sum/total);
+}
+
+[numthreads(8,8,1)]
+void DownsampleGrid(uint3 id:SV_DispatchThreadID) {
+    const bool right=id.z>=2;
+    const uint2 extent=gridSize(eyeSize(right));
+    if(any(id.xy>=extent))return;
+    float2 lo=float2(id.xy)/extent,hi=float2(id.xy+1)/extent;
+    const bool isFocus=(id.z&1)!=0;
+    const float4 inset=right?RightInset:Inset;
+    if(!isFocus){
+        lo=inset.xy+lo*inset.zw;
+        hi=inset.xy+hi*inset.zw;
+    }
+    const float4 uv=right?(isFocus?RightFocusUV:RightContextUV):(isFocus?FocusUV:ContextUV);
+    lo=uv.xy+lo*uv.zw;
+    hi=uv.xy+hi*uv.zw;
+    float3 average;
+    if(right){
+        if(isFocus)average=boxAverage(RightFocus,lo,hi);
+        else average=boxAverage(RightContext,lo,hi);
+    }else{
+        if(isFocus)average=boxAverage(Focus,lo,hi);
+        else average=boxAverage(Context,lo,hi);
+    }
+    GridOutput[id]=float4(average,1.0);
+}
+
+static const float3 Luma=float3(.2126,.7152,.0722);
+static const uint BandLanes=128;
+groupshared float3 bandOuter[3][BandLanes],bandFocus[3][BandLanes];
+
+float4 sideDistances(float2 uv) {
+    return float4(uv.x,1.0-uv.x,uv.y,1.0-uv.y);
+}
+
+float toneBand(float luma) {
+    // Linear-light anchors for the shadow, midtone and highlight gains.
+    return luma<.22?smoothstep(.04,.22,luma):1.0+smoothstep(.22,.65,luma);
+}
+
+[numthreads(BandLanes,1,1)]
+void ReduceToneBands(uint lane:SV_GroupIndex,uint3 group:SV_GroupID) {
+    const uint2 extent=gridSize(eyeSize(group.y!=0));
+    float3 outerSum[3],focusSum[3];
+    [unroll]for(uint band=0;band<3;++band){
+        outerSum[band]=0.0;
+        focusSum[band]=0.0;
+    }
+    for(uint index=lane;index<extent.x*extent.y;index+=BandLanes){
+        const uint2 xy=uint2(index%extent.x,index/extent.x);
+        const float3 outer=GridInput.Load(int4(xy,group.y*2,0)).rgb;
+        const float3 focus=GridInput.Load(int4(xy,group.y*2+1,0)).rgb;
+        const float tone=toneBand(dot(outer,Luma));
+        const float proximity=1.0-sideDistances((xy+.5)/extent)[group.x];
+        const float spatial=proximity*proximity;
+        [unroll]for(uint band=0;band<3;++band){
+            const float weight=spatial*saturate(1.0-abs(tone-float(band)));
+            outerSum[band]+=outer*weight;
+            focusSum[band]+=focus*weight;
+        }
+    }
+    [unroll]for(uint band=0;band<3;++band){
+        bandOuter[band][lane]=outerSum[band];
+        bandFocus[band][lane]=focusSum[band];
+    }
+    GroupMemoryBarrierWithGroupSync();
+    [unroll]for(uint stride=BandLanes/2;stride>0;stride>>=1){
+        if(lane<stride){
+            [unroll]for(uint band=0;band<3;++band){
+                bandOuter[band][lane]+=bandOuter[band][lane+stride];
+                bandFocus[band][lane]+=bandFocus[band][lane+stride];
+            }
+        }
+        GroupMemoryBarrierWithGroupSync();
+    }
+    if(lane<3){
+        const float3 gain=(bandFocus[lane][0]+.001)/(bandOuter[lane][0]+.001);
+        ToneGainOutput[uint2(lane,group.y*4+group.x)]=float4(gain,1.0);
+    }
+}
+
+float3 srgbEncode(float3 color) {
+    const float3 c=saturate(color);
+    return lerp(1.055*pow(c,1.0/2.4)-.055,12.92*c,step(c,.0031308));
+}
+
+float3 srgbDecode(float3 color) {
+    const float3 c=saturate(color);
+    return lerp(pow((c+.055)/1.055,2.4),c/12.92,step(c,.04045));
+}
+
+float4 directionWeights(float2 local,float softness) {
+    const float4 inv=rcp(sideDistances(local)+softness);
+    return inv*inv/dot(inv,inv);
+}
+
+// Each group fits one overlapping region along one edge for one eye.
+// Fixed-point sums keep the per-channel histograms within SM5 shared memory.
+groupshared int localDelta[768];
+groupshared uint localSupport[768];
+
+[numthreads(128,1,1)]
+void FitLocalChannels(uint lane:SV_GroupIndex,uint3 group:SV_GroupID) {
+    const uint zone=group.x,side=group.y,eye=group.z;
+    const bool right=eye!=0,vertical=side<2;
+    const float4 inset=right?RightInset:Inset;
+    const float4 outerUV=right?RightContextUV:ContextUV;
+    const float4 focusUV=right?RightFocusUV:FocusUV;
+    const float2 size=eyeSize(right);
+    const float extent=vertical?size.x:size.y;
+    uint width,height,layers;
+    if(right)RightContext.GetDimensions(width,height,layers);
+    else Context.GetDimensions(width,height,layers);
+    const float2 textureSize=float2(width,height);
+    const float2 origin=(outerUV.xy+inset.xy*outerUV.zw)*textureSize;
+    const float2 span=inset.zw*outerUV.zw*textureSize;
+    const float2 depth=saturate(float2(8,40)/extent);
+    const float2 normal=(side&1)?1-depth.yx:depth;
+    const float2 stripBegin=origin+span*(vertical?float2(normal.x,0):float2(0,normal.x));
+    const float2 stripEnd=origin+span*(vertical?float2(normal.y,1):float2(1,normal.y));
+    const float2 along=saturate((float(zone)+float2(-.5,1.5))/8);
+    const float2 zoneBegin=vertical?float2(stripBegin.x,origin.y+along.x*span.y):float2(origin.x+along.x*span.x,stripBegin.y);
+    const float2 zoneEnd=vertical?float2(stripEnd.x,origin.y+along.y*span.y):float2(origin.x+along.y*span.x,stripEnd.y);
+    const int2 begin=clamp(int2(floor(zoneBegin)),0,int2(width,height));
+    const int2 end=clamp(int2(ceil(zoneEnd)),0,int2(width,height));
+    const uint2 count=uint2(max(end-begin,0));
+    for(uint i=lane;i<768;i+=128){
+        localDelta[i]=0;
+        localSupport[i]=0;
+    }
+    GroupMemoryBarrierWithGroupSync();
+    for(uint i=lane;i<count.x*count.y;i+=128){
+        const int2 texel=begin+int2(i%count.x,i/count.x);
+        // A cut texel contributes in proportion to its overlap with the strip.
+        const float2 lo=max(float2(texel),stripBegin);
+        const float2 hi=min(float2(texel)+1,stripEnd);
+        const float2 overlap=max(hi-lo,0);
+        const float2 local=((lo+hi)*.5-origin)/span;
+        const float axis=clamp((vertical?local.y:local.x)*8-.5,0,7);
+        const float weight=overlap.x*overlap.y*smoothstep(0,1,1-abs(axis-float(zone)));
+        const uint fixedWeight=(uint)round(weight*256);
+        if(!fixedWeight)continue;
+        const float3 focusPos=float3(focusUV.xy+local*focusUV.zw,0);
+        const int4 outerPos=int4(texel,0,0);
+        const float3 raw=srgbEncode(right?RightContext.Load(outerPos).rgb:Context.Load(outerPos).rgb);
+        const float3 target=srgbEncode(right?RightFocus.SampleLevel(Linear,focusPos,0).rgb:
+            Focus.SampleLevel(Linear,focusPos,0).rgb);
+        [unroll]for(uint c=0;c<3;++c){
+            const uint code=(uint)round(raw[c]*255);
+            InterlockedAdd(localDelta[c*256+code],(int)round((target[c]-raw[c])*(255*fixedWeight)));
+            InterlockedAdd(localSupport[c*256+code],fixedWeight);
+        }
+    }
+    GroupMemoryBarrierWithGroupSync();
+    for(uint i=lane;i<768;i+=128){
+        const int c=int(i/256),code=int(i%256);
+        float d=0,w=0,kernel=0;
+        [unroll]for(int offset=-8;offset<=8;++offset){
+            const int value=code+offset;
+            const int reflected=value<0?-value-1:(value>255?511-value:value);
+            const float coeff=exp(-.125*offset*offset);
+            d+=coeff*localDelta[c*256+reflected];
+            w+=coeff*localSupport[c*256+reflected];
+            kernel+=coeff;
+        }
+        const float support=w+256*kernel;
+        const uint3 pos=uint3(code,zone,eye*12+side*3+c);
+        float2 fit=float2(d/(255*support),w/support);
+        // Smooth the correction and its support together so sparse bins fade consistently.
+        if(CurveHistoryWeight>0)
+            fit=lerp(fit,PreviousCurves.Load(int4(pos,0)).rg,CurveHistoryWeight);
+        CurveOutput[pos]=float4(fit,0,0);
+    }
+}
+
+float3 applyLocalChannels(float3 raw,float3 base,float2 local,float2 size) {
+    const float2 edge=saturate(local);
+    const float distance=length((local-edge)*size);
+    const float reach=.25*min(size.x,size.y);
+    [branch]if(distance>=reach)return base;
+    const float4 spatial=directionWeights(edge,.025);
+    const float3 value=srgbEncode(raw);
+    const float3 code=(value*255+.5)/256;
+    float3 delta=0,support=0;
+    [unroll]for(uint side=0;side<4;++side){
+        const float t=clamp(((side<2)?edge.y:edge.x)*8-.5,0,7);
+        const float zone=(floor(t)+smoothstep(0,1,frac(t))+.5)/8;
+        [unroll]for(uint c=0;c<3;++c){
+            const float2 fit=LocalCurves.SampleLevel(Linear,float3(code[c],zone,side*3+c),0).rg;
+            delta[c]+=spatial[side]*fit.x;
+            support[c]+=spatial[side]*fit.y;
+        }
+    }
+    const float3 corrected=srgbDecode(value*support+delta+srgbEncode(base)*(1-support));
+    return lerp(corrected,base,smoothstep(0,reach,distance));
+}
+
+float4 ApplyColorMatch(V v):SV_Target {
+    const float2 local=(v.uv-Inset.xy)/Inset.zw;
+    const float blend=quadFocusWeight(local,Inset.zw,Blend);
+    float4 c=Context.SampleLevel(Linear,float3(ContextUV.xy+v.uv*ContextUV.zw,0),0);
+    [branch]if(blend<1.0){
+        const float tone=toneBand(dot(c.rgb,Luma));
+        // Continue the nearest boundary's tonal correction outside the focus view.
+        const float4 weights=directionWeights(saturate(local),.1);
+        const float band=(tone+.5)/3.0;
+        float3 gain=0.0;
+        [unroll]for(uint side=0;side<4;++side)
+            gain+=weights[side]*Gains.SampleLevel(Linear,float2(band,float(side)),0).rgb;
+        const float3 base=c.rgb*gain;
+        c.rgb=applyLocalChannels(c.rgb,base,local,Inset.zw*Blend.xy);
+    }
+    const float4 f=Focus.SampleLevel(Linear,float3(FocusUV.xy+saturate(local)*FocusUV.zw,0),0);
+    return lerp(c,f,blend);
+}
+)HLSL";
+
+class QuadColorMatch11 {
+    template<class T> using Ptr = Microsoft::WRL::ComPtr<T>;
+    Ptr<ID3D11ComputeShader> downsample, reduce_tones, fit_local;
+    Ptr<ID3D11Buffer> right_constants;
+    Ptr<ID3D11ShaderResourceView> grid_colors;
+    Ptr<ID3D11UnorderedAccessView> write_grid;
+    std::array<Ptr<ID3D11ShaderResourceView>,2> eye_gains;
+    Ptr<ID3D11UnorderedAccessView> write_gains;
+    struct Curves {
+        Ptr<ID3D11Texture2D> texture;
+        Ptr<ID3D11UnorderedAccessView> output;
+        Ptr<ID3D11ShaderResourceView> history;
+        std::array<Ptr<ID3D11ShaderResourceView>,2> eyes;
+    };
+    std::array<Curves,2> curves;
+    unsigned current_curves{};
+    using Clock=std::chrono::steady_clock;
+    Clock::time_point last_fit{};
+    static constexpr UINT grid_size=64;
+
+    bool make_compute(ID3D11Device* device,const auto& bytecode,ID3D11ComputeShader** shader) {
+        Ptr<ID3DBlob> blob;
+        return SUCCEEDED(fg::bytecode::blob(bytecode,&blob))&&
+            SUCCEEDED(device->CreateComputeShader(blob->GetBufferPointer(),blob->GetBufferSize(),nullptr,shader));
+    }
+
+public:
+    Ptr<ID3D11PixelShader> apply;
+
+    bool initialize(ID3D11Device* device) {
+        if(curves[1].eyes[1])return true;
+        Ptr<ID3DBlob> pixel;
+        if(!make_compute(device,fg::bytecode::quad_color_match_downsamplegrid_cs_5_0,&downsample)||
+           !make_compute(device,fg::bytecode::quad_color_match_reducetonebands_cs_5_0,&reduce_tones)||
+           !make_compute(device,fg::bytecode::quad_color_match_fitlocalchannels_cs_5_0,&fit_local)||
+           FAILED(fg::bytecode::blob(fg::bytecode::quad_color_match_applycolormatch_ps_5_0,&pixel))||
+           FAILED(device->CreatePixelShader(pixel->GetBufferPointer(),pixel->GetBufferSize(),nullptr,&apply)))return false;
+
+        D3D11_BUFFER_DESC constants{};
+        constants.ByteWidth=80;
+        constants.BindFlags=D3D11_BIND_CONSTANT_BUFFER;
+        if(FAILED(device->CreateBuffer(&constants,nullptr,&right_constants)))return false;
+
+        D3D11_TEXTURE2D_DESC grid{};
+        grid.Width=grid.Height=grid_size;
+        grid.MipLevels=grid.SampleDesc.Count=1;
+        grid.ArraySize=4;
+        grid.Format=DXGI_FORMAT_R32G32B32A32_FLOAT;
+        grid.BindFlags=D3D11_BIND_SHADER_RESOURCE|D3D11_BIND_UNORDERED_ACCESS;
+        Ptr<ID3D11Texture2D> grid_texture;
+        if(FAILED(device->CreateTexture2D(&grid,nullptr,&grid_texture))||
+           FAILED(device->CreateShaderResourceView(grid_texture.Get(),nullptr,&grid_colors))||
+           FAILED(device->CreateUnorderedAccessView(grid_texture.Get(),nullptr,&write_grid)))return false;
+
+        D3D11_TEXTURE1D_DESC bands{};
+        bands.Width=3;
+        bands.MipLevels=1;
+        bands.ArraySize=8;
+        bands.Format=grid.Format;
+        bands.BindFlags=grid.BindFlags;
+        Ptr<ID3D11Texture1D> gains;
+        if(FAILED(device->CreateTexture1D(&bands,nullptr,&gains))||
+           FAILED(device->CreateUnorderedAccessView(gains.Get(),nullptr,&write_gains)))return false;
+        // Each draw reads only the tone gains from its own eye.
+        D3D11_SHADER_RESOURCE_VIEW_DESC slice{};
+        slice.Format=bands.Format;
+        slice.ViewDimension=D3D11_SRV_DIMENSION_TEXTURE1DARRAY;
+        slice.Texture1DArray.MipLevels=1;
+        slice.Texture1DArray.ArraySize=4;
+        for(UINT eye=0;eye<eye_gains.size();++eye){
+            slice.Texture1DArray.FirstArraySlice=eye*4;
+            if(FAILED(device->CreateShaderResourceView(gains.Get(),&slice,&eye_gains[eye])))return false;
+        }
+
+        const D3D11_TEXTURE2D_DESC desc{256,8,1,24,DXGI_FORMAT_R32G32B32A32_FLOAT,{1,0},D3D11_USAGE_DEFAULT,
+            D3D11_BIND_SHADER_RESOURCE|D3D11_BIND_UNORDERED_ACCESS,0,0};
+        D3D11_SHADER_RESOURCE_VIEW_DESC curve_slice{desc.Format,D3D11_SRV_DIMENSION_TEXTURE2DARRAY};
+        for(auto& table:curves){
+            if(FAILED(device->CreateTexture2D(&desc,nullptr,&table.texture))||
+               FAILED(device->CreateUnorderedAccessView(table.texture.Get(),nullptr,&table.output))||
+               FAILED(device->CreateShaderResourceView(table.texture.Get(),nullptr,&table.history)))return false;
+            curve_slice.Texture2DArray={0,1,0,12};
+            for(UINT eye=0;eye<table.eyes.size();++eye){
+                curve_slice.Texture2DArray.FirstArraySlice=eye*12;
+                if(FAILED(device->CreateShaderResourceView(table.texture.Get(),&curve_slice,&table.eyes[eye])))return false;
+            }
+        }
+        return true;
+    }
+
+    template<class Draw>
+    void record(ID3D11DeviceContext* ctx,ID3D11Buffer* left,ID3D11SamplerState* linear,
+        const std::array<Draw,2>& eyes) {
+        auto* right=right_constants.Get();
+        ctx->UpdateSubresource(left,0,nullptr,eyes[0].params.data(),0,0);
+        std::array<float,20> right_params{};
+        std::copy_n(eyes[1].params.data(),16,right_params.data());
+        const auto now=Clock::now();
+        if(last_fit!=Clock::time_point{}){
+            constexpr float half_life_seconds=.10f;
+            const float elapsed=std::chrono::duration<float>(now-last_fit).count();
+            right_params[16]=std::exp2(-elapsed/half_life_seconds);
+        }
+        last_fit=now;
+        ctx->UpdateSubresource(right,0,nullptr,right_params.data(),0,0);
+        ctx->CSSetConstantBuffers(0,1,&left);
+        ctx->CSSetConstantBuffers(2,1,&right);
+        ctx->CSSetSamplers(0,1,&linear);
+        ID3D11ShaderResourceView* inputs[]{eyes[0].sources[0].Get(),eyes[0].sources[1].Get(),nullptr,
+            eyes[1].sources[0].Get(),eyes[1].sources[1].Get()};
+        ctx->CSSetShaderResources(0,5,inputs);
